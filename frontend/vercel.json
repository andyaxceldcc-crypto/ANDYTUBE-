{
  "name": "vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/react"
    }
  ],
  "routes": [
    {
      "path": "/src/static/(.*)",
      "dest": "/src/static/$1"
    },
    {
      "path": "/src/next.config.js",
      "dest": "/src/next.config.js"
    },
    {
      "path": "/(.*)",
      "dest": "/index.html"
    }
  ]
}